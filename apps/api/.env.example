NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Instance PostgreSQL locale de FlowOps (port 5433) : voir docs/architecture.md, section Persistance
DATABASE_URL=postgresql://flowops:motdepasse@localhost:5433/flowops
TEST_DATABASE_URL=postgresql://flowops:motdepasse@localhost:5433/flowops_test
# Projet Firebase dont l'API accepte les jetons (Paramètres du projet > Général > ID du projet)
FIREBASE_PROJECT_ID=flowops-dev-xxxx
# Politique réseau du nœud HTTP (docs/security/http-node.md). Vides : adresses publiques seules.
# Installation en entreprise, ex. : HTTP_ALLOWED_TARGETS=10.20.0.0/16,*.interne.entreprise.fr
HTTP_ALLOWED_TARGETS=
HTTP_DENIED_TARGETS=
# Sessions de démo (docs/security/demo-sessions.md) : false refuse les comptes anonymes
DEMO_SESSIONS_ENABLED=true
# Proxys de confiance devant l'API : 0 en local, 1 derrière Cloud Run
TRUST_PROXY_HOPS=0
# Diagnostic temporaire des en-têtes d'adresse (réglage de TRUST_PROXY_HOPS), voir deploy/README.md
LOG_FORWARDED_FOR=false
