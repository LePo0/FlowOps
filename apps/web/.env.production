# Configuration web du projet Firebase de production (flowops-prod), utilisée par `vite build`.
# Ces valeurs sont publiques : elles sont lues par le navigateur. L'accès est protégé par les
# domaines autorisés de Firebase Auth et par la restriction de la clé d'API au domaine de
# l'éditeur (deploy/README.md). Lu seulement par `vite build` : `npm run dev:web` garde
# apps/web/.env.local (projet de développement).
VITE_FIREBASE_API_KEY=AIzaSyBZMDoOOVFjQTUb2TZDEP-7jNUMNTQfpxw
VITE_FIREBASE_AUTH_DOMAIN=flowops-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flowops-prod
VITE_FIREBASE_APP_ID=1:592511140226:web:946247d4023a8b8a12cf9b
